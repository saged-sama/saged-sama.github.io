---
/**
 * The owner's photo; clicking it opens the full photo over the page. Uses the
 * HTML popover attribute, so it works without JavaScript (click outside or Escape closes it).
 */
import Img from '@/components/Img.astro';

type Props = { src: ImageMetadata; alt: string; size?: 'md' | 'lg' };
const { src, alt, size = 'lg' } = Astro.props;
const px = size === 'lg' ? 176 : 112;
---

<div class="relative shrink-0">
	<button
		type="button"
		popovertarget="avatar-full"
		class="relative block cursor-zoom-in outline-offset-4 transition-transform hover:scale-[1.02]"
		aria-label={`Show larger photo: ${alt}`}
	>
		<Img
			src={src}
			alt={alt}
			width={px}
			height={px}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
			class:list={['object-cover rounded-full', size === 'lg' ? 'size-36 sm:size-44' : 'size-28']}
		/>
	</button>
</div>

<div
	id="avatar-full"
	popover
	class="m-auto max-h-[90dvh] max-w-[min(90vw,40rem)] overflow-visible bg-transparent p-0 backdrop:bg-background/90"
>
	<button type="button" popovertarget="avatar-full" popovertargetaction="hide" class="block cursor-zoom-out" aria-label="Close photo">
		<Img src={src} alt={alt} widths={[480, 960]} sizes="min(90vw, 40rem)" class="max-h-[90dvh] w-auto object-contain shadow-2xl" />
	</button>
</div>
