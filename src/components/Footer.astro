---
/** Site footer: logo with a short line, the main links, social links and copyright. */
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { profile } from '@/lib/content';
import { navLinks } from '@/lib/nav';

type Props = { width?: string };
const { width = 'max-w-5xl' } = Astro.props;
const { name, headline, location, resume } = await profile();
const line = [headline, location].filter(Boolean).join(' · ');
---

<footer class="mt-16 border-t">
	<div class={`mx-auto grid ${width} gap-8 px-4 py-12 sm:grid-cols-[1fr_auto] sm:px-6`}>
		<div class="grid content-start gap-3">
			<Logo name={name} />
			{line && <p class="text-sm text-muted-foreground">{line}</p>}
		</div>
		<nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground sm:justify-end">
			{navLinks(resume).map((link) => <a href={link.href} class="hover:text-foreground">{link.label}</a>)}
			<a href="/rss.xml" class="hover:text-foreground">RSS</a>
		</nav>
		<p class="num text-sm text-muted-foreground">© {new Date().getFullYear()} {name}</p>
		<SocialLinks class="-mr-2 sm:justify-end" />
	</div>
</footer>
