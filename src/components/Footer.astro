---
import SocialLinks from './SocialLinks.astro';
import { profile } from '@/lib/content';

const { name } = await profile();
---

<footer class="border-t">
	<div
		class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:px-6"
	>
		<p>© <span class="num">{new Date().getFullYear()}</span> {name}</p>
		<SocialLinks />
	</div>
</footer>
