---
/** Site header: logo (home link), main navigation and the theme switch. */
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '@/lib/content';
import { isCurrent, navLinks } from '@/lib/nav';

type Props = { width?: string };
const { width = 'max-w-5xl' } = Astro.props;
const { name, resume } = await profile();
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-background/95 sm:bg-background/75 sm:backdrop-blur-md">
	<div class={`mx-auto flex h-16 ${width} items-center gap-2 px-4 sm:gap-4 sm:px-6`}>
		<Logo name={name} compact class="mr-auto" />
		<nav aria-label="Main" class="flex shrink-0 items-center text-sm">
			{
				navLinks(resume).map((link) => (
					<a
						href={link.href}
						aria-current={isCurrent(link.href, path) ? 'page' : undefined}
						class="relative px-2 py-1.5 whitespace-nowrap text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground sm:px-3"
					>
						{link.label}
						{isCurrent(link.href, path) && (
							<span class="absolute inset-x-2 -bottom-0.5 h-0.5 bg-highlight sm:inset-x-3" aria-hidden="true" />
						)}
					</a>
				))
			}
		</nav>
		<ThemeToggle />
	</div>
</header>
