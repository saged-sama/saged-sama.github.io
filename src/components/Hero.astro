---
/** The home page's welcome: greeting with the name, what I do, a short line, and where to go next. */
import ArrowDown from '@lucide/astro/icons/arrow-down';
import MapPin from '@lucide/astro/icons/map-pin';
import Rocket from '@lucide/astro/icons/rocket';
import Avatar from './Avatar.astro';
import SocialLinks from './SocialLinks.astro';
import { cn } from 'cn';
import { buttonVariants } from '@/components/ui/button';
import { profile } from '@/lib/content';

const me = await profile();
const firstName = me.name.split(' ')[0];
---

<section aria-label="Introduction" class="grid items-center gap-10 pt-10 pb-16 sm:pt-20 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16">
	<div class="grid gap-6">
		<div class="flex flex-wrap items-center gap-2 text-sm">
			{
				me.openToWork && (
					<span class="inline-flex items-center gap-2 bg-muted px-3 py-1 font-medium">
						<span class="size-2 bg-live" aria-hidden="true" />
						{me.availability ?? 'Open to new work'}
					</span>
				)
			}
			{
				me.location && (
					<span class="inline-flex items-center gap-1.5 bg-muted px-3 py-1 text-muted-foreground">
						<MapPin class="size-3.5" />
						{me.location}
					</span>
				)
			}
		</div>

		<h1 class="text-5xl leading-[1.05] font-semibold tracking-tighter sm:text-6xl lg:text-7xl">
			Hi, I’m <span class="text-highlight">{firstName}</span>.
			{me.shortBio && <span class="block text-muted-foreground">{me.shortBio}</span>}
		</h1>

		{me.headline && <p class="max-w-xl text-lg text-pretty text-muted-foreground">{me.headline}</p>}

		<div class="flex flex-wrap items-center gap-3">
			<a href="#work" class={cn(buttonVariants({ size: 'lg' }), 'px-5')}>
				See my work
				<ArrowDown />
			</a>
			{
				me.resume && (
					<a href={me.resume} class={cn(buttonVariants({ size: 'lg', variant: 'secondary' }), 'px-5')}>
						<Rocket />
						Résumé
					</a>
				)
			}
			<SocialLinks class="ml-1" />
		</div>
	</div>

	{me.avatar && <div class="max-md:-order-1"><Avatar src={me.avatar} alt={me.avatarAlt ?? me.name} /></div>}
</section>
