---
/** Top of the home page: photo, name, headline, short bio, links and the résumé. */
import Download from '@lucide/astro/icons/download';
import MapPin from '@lucide/astro/icons/map-pin';
import Avatar from './Avatar.astro';
import SocialLinks from './SocialLinks.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { profile } from '@/lib/content';

const me = await profile();
---

<section aria-label="Introduction" class="flex flex-col gap-6 py-6 sm:flex-row sm:items-center sm:gap-8">
	{me.avatar && <Avatar src={me.avatar} alt={me.avatarAlt ?? me.name} />}
	<div class="grid min-w-0 gap-3">
		<div>
			<h1>{me.name}</h1>
			{
				me.headline && (
					<p class="mt-1 text-xl text-muted-foreground">
						{me.headline}
						{me.pronouns && <span class="text-base"> ({me.pronouns})</span>}
					</p>
				)
			}
		</div>
		{me.shortBio && <p class="max-w-prose text-pretty">{me.shortBio}</p>}
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
			{
				me.location && (
					<span class="inline-flex items-center gap-1">
						<MapPin class="size-4" />
						{me.location}
					</span>
				)
			}
			{me.openToWork && <Badge>{me.availability ?? 'Open to work'}</Badge>}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			{
				me.resume && (
					<a href={me.resume} class={buttonVariants({ size: 'sm' })}>
						<Download />
						Résumé
					</a>
				)
			}
			<SocialLinks labels />
		</div>
	</div>
</section>
