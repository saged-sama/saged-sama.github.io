---
/** The top of a list page (Work, Writing, About): eyebrow, title and a one-line description. */
type Props = { eyebrow: string; title: string; description?: string };
const { eyebrow, title, description } = Astro.props;
---

<header class="hero-glow grid gap-3 pt-8 pb-10 sm:pt-14">
	<p class="eyebrow rise">{eyebrow}</p>
	<h1 class="rise" style="--i: 1">{title}</h1>
	{description && <p class="rise max-w-2xl text-lg text-pretty text-muted-foreground" style="--i: 2">{description}</p>}
	<slot />
</header>
