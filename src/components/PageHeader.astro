---
/** The top of a list page (Projects, About): eyebrow, title and a one-line description. */
type Props = { eyebrow: string; title: string; description?: string };
const { eyebrow, title, description } = Astro.props;
---

<header class="grid gap-3 pt-8 pb-10 sm:pt-14">
	<p class="eyebrow">{eyebrow}</p>
	<h1>{title}</h1>
	<slot />
</header>
