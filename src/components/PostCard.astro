---
/**
 * A post in a list, magazine style: date on the left, title and summary, thumbnail on the right.
 * Rows are separated by hairlines (see PostList.astro); the whole row links to the post.
 */
import type { CollectionEntry } from 'astro:content';
import Img from '@/components/Img.astro';
import { formatDate, isoDay } from '@/lib/dates';
import { readingTime } from '@/lib/reading-time';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { id, data } = post;
---

<article class="group relative grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[8rem_minmax(0,1fr)_auto]">
	<p class="num pt-1 text-sm text-muted-foreground">
		<time datetime={isoDay(data.date)}>{formatDate(data.date)}</time>
	</p>
	<div class="grid content-start gap-2">
		<h3 class="text-xl group-hover:text-highlight">
			<a href={`/blog/${id}/`} class="after:absolute after:inset-0">{data.title}</a>
		</h3>
		{data.summary && <p class="line-clamp-2 text-pretty text-muted-foreground">{data.summary}</p>}
		<p class="num text-sm text-muted-foreground">{readingTime(post)} min read</p>
	</div>
	{
		data.cover && (
			<Img
				src={data.cover}
				alt=""
				widths={[200, 400]}
				sizes="10rem"
				class="aspect-4/3 w-40 rounded-xl border object-cover transition-transform duration-300 group-hover:scale-[1.02] max-sm:row-start-1 max-sm:w-full max-sm:aspect-video"
			/>
		)
	}
</article>
