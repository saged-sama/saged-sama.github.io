---
/** Posts as rows, one after another. */
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

/** `eagerFirst`: the first row is at the top of the page (its thumbnail is the main image). */
type Props = { posts: CollectionEntry<'blog'>[]; eagerFirst?: boolean };
const { posts, eagerFirst = false } = Astro.props;
---

<div class="grid gap-2">
	{posts.map((post, i) => <PostCard post={post} eager={eagerFirst && i === 0} />)}
</div>
