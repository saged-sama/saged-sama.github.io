---
/** A project in a grid: showcase cover, title, summary and categories; links to its page. */
import type { CollectionEntry } from 'astro:content';
import FolderCode from '@lucide/astro/icons/folder-code';
import Showcase from './Showcase.astro';
import Tags from './Tags.astro';

type Props = { project: CollectionEntry<'projects'> };
const { id, data } = Astro.props.project;
---

<article class="group relative flex flex-col gap-3">
	{
		data.cover ? (
			<Showcase src={data.cover} alt={data.coverAlt ?? data.title} />
		) : (
			<div class="grid aspect-16/10 place-items-center rounded-xl bg-muted text-muted-foreground">
				<FolderCode class="size-10" />
			</div>
		)
	}
	<h3 class="text-lg font-semibold">
		<!-- The link covers the whole card. -->
		<a href={`/projects/${id}/`} class="after:absolute after:inset-0 group-hover:underline">{data.title}</a>
	</h3>
	{data.summary && <p class="line-clamp-3 text-sm text-muted-foreground">{data.summary}</p>}
	<Tags items={data.categories} />
</article>
