---
/** A titled block of a page: eyebrow label, title, optional intro line and "see all" link. */
import ArrowRight from '@lucide/astro/icons/arrow-right';

type Props = {
	id: string;
	eyebrow?: string;
	title: string;
	description?: string;
	href?: string;
	hrefLabel?: string;
	class?: string;
};
const { id, eyebrow, title, description, href, hrefLabel = 'See all', class: className = '' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class={`scroll-mt-24 py-14 sm:py-20 ${className}`}>
	<div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
		<div class="grid gap-2">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 id={`${id}-title`}>{title}</h2>
			{description && <p class="max-w-xl text-pretty text-muted-foreground">{description}</p>}
		</div>
		{
			href && (
				<a href={href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-highlight">
					{hrefLabel}
					<ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
				</a>
			)
		}
	</div>
	<slot />
</section>
