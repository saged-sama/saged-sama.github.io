---
/** Skills grouped by category: one tile per category, each skill as an icon chip. */
import Icon from './Icon.astro';
import { skillGroups } from '@/lib/content';

const groups = await skillGroups();
---

<div class="grid gap-4 sm:grid-cols-2">
	{
		groups.map(({ category, skills }) => (
			<div class="surface p-5">
				<h3 class="mb-4 text-sm font-medium text-muted-foreground">{category}</h3>
				<ul class="flex flex-wrap gap-2">
					{skills.map(({ data }) => (
						<li class="inline-flex items-center gap-2 bg-background px-3 py-1.5 text-sm">
							<Icon name={data.icon} class="size-4 text-highlight" />
							{data.name}
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
