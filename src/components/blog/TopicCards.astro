---
/** Subtopics as cards: name, description and how many posts they hold. */
import Folder from '@lucide/astro/icons/folder';
import type { Topic } from '@/lib/blog-tree';
import { postCount } from '@/lib/blog-tree';

type Props = { topics: Topic[] };
const { topics } = Astro.props;
---

{
	topics.length > 0 && (
		<ul class="grid gap-3 sm:grid-cols-2">
			{topics.map((topic) => (
				<li>
					<a href={`/blog/${topic.path}/`} class="surface group flex h-full gap-3 p-4 transition-colors hover:border-brand-2/50">
						<Folder class="mt-0.5 size-5 shrink-0 text-highlight" />
						<span class="grid min-w-0 gap-1">
							<span class="font-medium group-hover:text-highlight">{topic.label}</span>
							{topic.description && <span class="line-clamp-2 text-sm text-muted-foreground">{topic.description}</span>}
							<span class="num text-xs text-muted-foreground">
								{postCount(topic)} post{postCount(topic) === 1 ? '' : 's'}
								{topic.topics.length > 0 && ` · ${topic.topics.length} subtopic${topic.topics.length === 1 ? '' : 's'}`}
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	)
}
