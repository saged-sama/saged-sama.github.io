---
/**
 * One level of the blog sidebar: the topic's own posts, then its subtopics as collapsible groups
 * (native <details>, no JavaScript). The branch holding the current page starts open.
 */
import ChevronRight from '@lucide/astro/icons/chevron-right';
import type { Topic } from '@/lib/blog-tree';
import { postCount } from '@/lib/blog-tree';

type Props = { topic: Topic; current: string };
const { topic, current } = Astro.props;

const isOpen = (t: Topic) => current === t.path || current.startsWith(`${t.path}/`);
const linkClass =
	'block truncate rounded-md border-l-2 border-transparent py-1.5 pr-2 pl-3 text-muted-foreground hover:bg-muted/60 hover:text-foreground aria-[current=page]:border-brand-2 aria-[current=page]:bg-secondary aria-[current=page]:font-medium aria-[current=page]:text-foreground';
---

<ul class="grid gap-0.5">
	{
		topic.posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`} aria-current={current === post.id ? 'page' : undefined} class={linkClass} title={post.data.title}>
					{post.data.title}
				</a>
			</li>
		))
	}
	{
		topic.topics.map((child) => (
			<li>
				<details open={isOpen(child)}>
					<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md py-1.5 pr-2 pl-1 font-medium hover:bg-muted/60 [&::-webkit-details-marker]:hidden">
						<ChevronRight class="size-4 shrink-0 text-muted-foreground transition-transform [details[open]>summary>&]:rotate-90" />
						<a
							href={`/blog/${child.path}/`}
							aria-current={current === child.path ? 'page' : undefined}
							class="min-w-0 flex-1 truncate hover:text-highlight aria-[current=page]:text-highlight"
						>
							{child.label}
						</a>
						<span class="num text-xs text-muted-foreground">{postCount(child)}</span>
					</summary>
					<div class="ml-3 border-l pl-2">
						<Astro.self topic={child} current={current} />
					</div>
				</details>
			</li>
		))
	}
</ul>
