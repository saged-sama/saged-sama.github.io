---
/**
 * A blog post or project page: back link, title, summary, a `meta` slot (dates, links, …), a
 * `hero` slot (cover), the body as prose, and an `after` slot (gallery, tags).
 */
import 'katex/dist/katex.min.css';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import PageLayout from './PageLayout.astro';
import Prose from '@/components/Prose.astro';
import type { SeoProps } from '@/components/Seo.astro';
import type { TrackTarget } from '@/lib/telemetry';

type Props = SeoProps & {
	heading: string;
	summary?: string;
	back: { href: string; label: string };
	track?: TrackTarget;
};
const { heading, summary, back, ...seo } = Astro.props;
---

<PageLayout {...seo}>
	<article class="mx-auto max-w-3xl">
		<header class="grid gap-4 pt-6 sm:pt-10">
			<a href={back.href} class="group inline-flex w-fit items-center gap-1.5 text-sm text-muted-foreground hover:text-highlight">
				<ArrowLeft class="size-4 transition-transform group-hover:-translate-x-0.5" />
				{back.label}
			</a>
			<h1 class="mt-4 text-4xl leading-tight sm:text-5xl">{heading}</h1>
			{summary && <p class="text-lg text-pretty text-muted-foreground sm:text-xl">{summary}</p>}
			<div class="grid gap-4"><slot name="meta" /></div>
		</header>
		<div class="my-10 empty:hidden"><slot name="hero" /></div>
		<Prose class="text-lg/8"><slot /></Prose>
		<slot name="after" />
	</article>
</PageLayout>
