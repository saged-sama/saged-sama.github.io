---
/**
 * The blog's documentation-style frame: topic sidebar on the left (a collapsible "Browse topics"
 * panel on phones), the page in the middle, and an optional `aside` slot on the right (e.g. "On
 * this page") on wide screens.
 */
import ListTree from '@lucide/astro/icons/list-tree';
import PageLayout from './PageLayout.astro';
import BlogSidebar from '@/components/blog/BlogSidebar.astro';
import type { SeoProps } from '@/components/Seo.astro';
import type { Topic } from '@/lib/blog-tree';

type Props = SeoProps & { tree: Topic; current: string };
const { tree, current, ...seo } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<PageLayout {...seo} wide>
	<div class:list={['grid gap-10 pt-8 lg:grid-cols-[15rem_minmax(0,1fr)]', hasAside && 'xl:grid-cols-[15rem_minmax(0,1fr)_13rem]']}>
		<aside class="lg:sticky lg:top-20 lg:max-h-[calc(100dvh-6rem)] lg:self-start lg:overflow-y-auto lg:pr-2">
			<details class="surface group/browse p-3 lg:hidden">
				<summary class="flex cursor-pointer list-none items-center gap-2 font-medium [&::-webkit-details-marker]:hidden">
					<ListTree class="size-4 text-highlight" />Browse topics
				</summary>
				<div class="mt-3"><BlogSidebar tree={tree} current={current} /></div>
			</details>
			<div class="max-lg:hidden"><BlogSidebar tree={tree} current={current} /></div>
		</aside>
		<div class="min-w-0"><slot /></div>
		{
			hasAside && (
				<aside class="max-xl:hidden xl:sticky xl:top-20 xl:self-start">
					<slot name="aside" />
				</aside>
			)
		}
	</div>
</PageLayout>
