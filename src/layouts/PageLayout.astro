---
/** A regular page: header, content column, footer. `wide` widens all three (the blog's docs layout). */
import RootLayout from './RootLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Track from '@/components/Track.astro';
import type { SeoProps } from '@/components/Seo.astro';
import type { TrackTarget } from '@/lib/telemetry';

type Props = SeoProps & { class?: string; wide?: boolean; /** What visits to this page count toward. */ track?: TrackTarget };
const { class: className = '', wide = false, track, ...seo } = Astro.props;
const width = wide ? 'max-w-7xl' : 'max-w-5xl';
---

<RootLayout {...seo}>
	<!-- overflow-x-clip: tilted project covers may reach past the column but never scroll the page. -->
	<div class="flex min-h-dvh flex-col overflow-x-clip">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-background focus:px-3 focus:py-2"
			>Skip to content</a
		>
		<Header width={width} />
		<main id="main" class={`mx-auto w-full flex-1 px-4 pb-10 sm:px-6 ${width} ${className}`}>
			<slot />
		</main>
		<Footer width={width} />
	</div>
	<Track target={track} />
</RootLayout>
