---
/** A regular page: header, content column, footer. */
import RootLayout from './RootLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { SeoProps } from '@/components/Seo.astro';

type Props = SeoProps & { class?: string };
const { class: className = '', ...seo } = Astro.props;
---

<RootLayout {...seo}>
	<!-- overflow-x-clip: decorative glows reach past the column but never scroll the page. -->
	<div class="flex min-h-dvh flex-col overflow-x-clip">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
			>Skip to content</a
		>
		<Header />
		<main id="main" class={`mx-auto w-full max-w-5xl flex-1 px-4 pb-10 sm:px-6 ${className}`}>
			<slot />
		</main>
		<Footer />
	</div>
</RootLayout>
