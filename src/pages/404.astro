---
import House from '@lucide/astro/icons/house';
import PageLayout from '@/layouts/PageLayout.astro';
import { buttonVariants } from '@/components/ui/button';
---

<PageLayout title="Page not found" noindex>
	<div class="mx-auto grid max-w-md justify-items-center gap-3 py-24 text-center">
		<p class="num text-sm text-muted-foreground">Error 404</p>
		<h1 class="text-2xl">This page doesn’t exist</h1>
		<p class="text-pretty text-muted-foreground">The link may be broken, or the page was moved or removed.</p>
		<a href="/" class={`mt-4 ${buttonVariants()}`}><House />Go home</a>
	</div>
</PageLayout>
