---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import { posts, profile } from '@/lib/content';

const [me, all] = await Promise.all([profile(), posts()]);
const description = 'Notes and essays on whatever I’m curious about.';
---

<PageLayout title={`Writing · ${me.name}`} description={description}>
	<PageHeader eyebrow="Writing" title="Notes & essays" description={description} />
	{all.length ? <PostList posts={all} /> : <p class="text-muted-foreground">No posts yet.</p>}
</PageLayout>
