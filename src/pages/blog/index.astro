---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { posts, profile } from '@/lib/content';

const [me, all] = await Promise.all([profile(), posts()]);
---

<PageLayout title={`Blog · ${me.name}`} description={`Posts by ${me.name}.`}>
	<h1>Blog</h1>
	{
		all.length ? (
			<div class="-mx-3 mt-8 grid gap-2">
				{all.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<p class="mt-8 text-muted-foreground">No posts yet.</p>
		)
	}
</PageLayout>
