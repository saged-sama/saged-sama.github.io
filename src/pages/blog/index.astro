---
/** The blog's front page: its topics, then the newest posts from everywhere. */
import DocsLayout from '@/layouts/DocsLayout.astro';
import PostList from '@/components/PostList.astro';
import TopicCards from '@/components/blog/TopicCards.astro';
import { blogTree } from '@/lib/blog-tree';
import { posts, profile } from '@/lib/content';

const [me, tree, all] = await Promise.all([profile(), blogTree(), posts()]);
const description = 'Notes, essays and tutorials, organized by topic.';
const LATEST = 5;
---

<DocsLayout title={`Blog · ${me.name}`} description={description} tree={tree} current="">
	<header class="grid gap-3 pb-8">
		<p class="eyebrow">Blog</p>
		<h1>Notes & essays</h1>
		<p class="max-w-2xl text-lg text-pretty text-muted-foreground">{description}</p>
	</header>

	{
		tree.topics.length > 0 && (
			<section aria-labelledby="topics-title" class="pb-10">
				<h2 id="topics-title" class="mb-4 text-xl">Topics</h2>
				<TopicCards topics={tree.topics} />
			</section>
		)
	}

	<section aria-labelledby="latest-title">
		<h2 id="latest-title" class="mb-2 text-xl">Latest</h2>
		{all.length ? <PostList posts={all.slice(0, LATEST)} eagerFirst={!tree.topics.length} /> : <p class="text-muted-foreground">No posts yet.</p>}
	</section>
</DocsLayout>
