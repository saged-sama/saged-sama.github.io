---
import { getImage } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import CareerList from '@/components/CareerList.astro';
import Hero from '@/components/Hero.astro';
import PostList from '@/components/PostList.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import Section from '@/components/Section.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import { list, posts, profile, projects } from '@/lib/content';
import { fromExperience } from '@/lib/timeline';

/*
 * The home page is a welcome, not a CV: who I am, what I've made, what I write, and a glance at
 * where I've worked. The full story (bio, timeline, education, achievements) is on /about.
 */
const me = await profile();
const [experience, skills, testimonials, allProjects, allPosts] = await Promise.all([
	list('experience'),
	list('skills'),
	list('testimonials'),
	projects(),
	posts()
]);

const HOME_PROJECTS = 3;
const HOME_POSTS = 3;
// Current roles first, then the rest by the order set in the admin.
const roles = [...experience].sort((a, b) => Number(b.data.current) - Number(a.data.current)).map(fromExperience);

const photo = me.avatar ? await getImage({ src: me.avatar, width: 400 }) : undefined;
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: me.name,
	url: Astro.site?.href,
	jobTitle: me.headline,
	image: photo ? new URL(photo.src, Astro.site).href : undefined,
	address: me.location
};
---

<PageLayout
	title={me.seo.title ?? (me.headline ? `${me.name} · ${me.headline}` : me.name)}
	description={me.seo.description ?? me.shortBio ?? me.headline}
	image={me.seo.image ?? me.avatar}
	type="profile"
	jsonLd={person}
>
	<Hero />

	{
		allProjects.length > 0 && (
			<Section
				id="work"
				eyebrow="Selected work"
				title="Things I’ve built"
				href={allProjects.length > HOME_PROJECTS ? '/projects/' : undefined}
				hrefLabel="All projects"
			>
				<ProjectGrid projects={allProjects.slice(0, HOME_PROJECTS)} />
			</Section>
		)
	}

	{
		allPosts.length > 0 && (
			<Section id="writing" eyebrow="Writing" title="Notes & essays" href="/blog/" hrefLabel="All posts">
				<PostList posts={allPosts.slice(0, HOME_POSTS)} />
			</Section>
		)
	}

	{
		roles.length > 0 && (
			<Section id="experience" eyebrow="Experience" title="Where I’ve worked" href="/about/#experience" hrefLabel="The full story">
				<CareerList entries={roles} />
			</Section>
		)
	}

	{
		skills.length > 0 && (
			<Section id="toolbox" eyebrow="Toolbox" title="What I work with">
				<SkillGroups />
			</Section>
		)
	}

	{
		testimonials.length > 0 && (
			<Section id="testimonials" eyebrow="Kind words" title="What people say">
				<div class="grid gap-4 sm:grid-cols-2">
					{testimonials.map((t) => <TestimonialCard testimonial={t} />)}
				</div>
			</Section>
		)
	}
</PageLayout>
