---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import { profile, projects } from '@/lib/content';

const [me, all] = await Promise.all([profile(), projects()]);
const description = 'Products, experiments and things I’ve helped build.';
---

<PageLayout title={`Work · ${me.name}`} description={description}>
	<PageHeader eyebrow="Work" title="Things I’ve built" description={description} />
	{all.length ? <ProjectGrid projects={all} /> : <p class="text-muted-foreground">No projects yet.</p>}
</PageLayout>
